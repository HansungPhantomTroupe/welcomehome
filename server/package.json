{
  "name": "server",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "collect": "tsx scripts/collect.ts",
    "gen:grid": "tsx scripts/genGrid.ts",
    "build:features": "tsx scripts/buildFeatures.ts",
    "data": "npm run gen:grid && npm run collect && npm run build:features",
    "typecheck": "tsc --noEmit",
    "import:generated": "tsx scripts/importGenerated.ts"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "pg": "^8.23.1",
    "proj4": "^2.15.0",
    "quickjs-emscripten": "^0.31.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "@types/proj4": "^2.5.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
