{
  "name": "welcome-home",
  "private": true,
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
    "data": "npm run data -w server",
    "collect": "npm run collect -w server",
